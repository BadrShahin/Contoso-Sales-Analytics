table MeasureCatalog
	lineageTag: 2780c01b-3200-40d6-8a19-3e0f7e39ee8b

	measure 'Average Order Value' =
			
			DIVIDE (
			    [Total Sales],
			    [Total Orders]
			)
		formatString: 0.00
		displayFolder: Orders
		lineageTag: 6a56a8a2-0db8-42b0-90dc-ae8d07b1651a

	measure 'Profit Margin %' =
			
			DIVIDE (
			    [Total Profit],
			    [Total Sales]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Profit
		lineageTag: fe3ed3c1-ef99-4577-b4ae-532feae694fc

	measure 'Total Cost' =
			
			SUM ( FactSales[TotalCost] )
		formatString: 0.00
		displayFolder: Cost
		lineageTag: ba7e0a9b-ee00-421f-822c-32f8a2f8fd9c

	measure 'Total Orders' =
			
			DISTINCTCOUNT ( FactSales[SalesKey] )
		formatString: 0
		displayFolder: Orders
		lineageTag: 85b94a5e-01e7-4717-940c-7a72640c6479

	measure 'Total Profit' =
			
			[Total Sales] - [Total Cost]
		formatString: 0.00
		displayFolder: Profit
		lineageTag: 3d009599-738c-4744-a3b3-647bda799226

	measure 'Total Sales' =
			
			SUM ( FactSales[SalesAmount] )
		formatString: 0.00
		displayFolder: Sales
		lineageTag: 83e94fa5-d1f8-4cb2-bb1c-7d6ba78b3b50

	measure 'Sales Quantity' =
			
			SUM ( FactSales[SalesQuantity] )
		formatString: 0
		displayFolder: Sales
		lineageTag: 18414e11-e26f-4796-bc04-76aee9c6b1a0

	measure 'Average Selling Price' =
			
			DIVIDE ( [Total Sales], [Sales Quantity] )
		formatString: 0.00
		displayFolder: Sales
		lineageTag: 4e5ffe67-7324-42b2-b7a0-030014d940dc

	column Placeholder
		isHidden
		lineageTag: 35ff243c-bdfc-48e3-84fd-0d31e1ab3795
		summarizeBy: none
		isNameInferred
		sourceColumn: [Placeholder]

		annotation SummarizationSetBy = Automatic

	partition MeasureCatalog = calculated
		mode: import
		source =
				
				DATATABLE (
				    "Placeholder", STRING,
				    {
				        { "" }
				    }
				)

	annotation PBI_Id = d2ecb1e7bffd4a8ba8b8500205cfbb22

